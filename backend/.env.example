# ==============================================================================
# Zentro Backend Environment Variables
# ==============================================================================

# Application Information
PROJECT_NAME="Zentro API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Security & JWT Token Authentication
SECRET_KEY="zentro-insecure-dev-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default local fallback (zero external setup): SQLite async
DATABASE_URL="sqlite+aiosqlite:///./zentro.db"
# Primary Production/Docker (PostgreSQL with pgvector):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/zentro_db"

# AI Provider Configuration
# Options: 'openai', 'gemini', 'groq', 'mock'
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_CHAT_MODEL="gpt-4o-mini"
