# ==============================================================================
# Zentro - Root Docker & Local Environment Variables (.env.example)
# Copy this file to .env before starting the Docker Compose stack:
# cp .env.example .env
# ==============================================================================

# Database (PostgreSQL + pgvector)
POSTGRES_DB=zentro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend Service
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=zentro-insecure-dev-secret-key-change-in-production-min-32-chars-long
AUTO_SEED=true

# AI Provider Configuration ('mock' requires no API key, or 'openai')
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Frontend Service
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
